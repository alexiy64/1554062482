#include <stdio.h>
#include <stdlib.h>

int main(void) {
    // Исходный массив
    int k;
    printf("Сколько чисел? ");
    scanf("%d", &k);

    // Заказываем память
    int *arr = malloc(k * sizeof(int)); 

    if (arr == NULL) {
        printf("Ошибка: не хватило памяти!\n");
        return 1;
    }

    for (int i = 0; i < k; i++) {
        scanf("%d", &arr[i]);
    }

    //возвращаем память
    free(arr); 

    printf("Исходный массив: ");
    for (int i = 0; i < k; i++) {
        printf("%d ", arr[i]);
    }
    printf("\k");

    // --- ЛОГИКА СОРТИРОВКИ ---
    
    // Внешний цикл: сколько раз мы проходим по массиву
    for (int i = 0; i < k - 1; i++) {
        
        // Внутренний цикл: сравниваем соседние элементы
        // n - i - 1 нужно, чтобы не проверять элементы, которые уже "всплыли" в конец
        for (int j = 0; j < k - i - 1; j++) {
            
            // Если текущий элемент больше следующего — меняем их местами
            if (arr[j] > arr[j + 1]) {
                // Обмен значений через временную переменную (temp)
                int temp = arr[j];
                arr[j] = arr[j + 1];
                arr[j + 1] = temp;
            }
        }
    }

    // --- КОНЕЦ СОРТИРОВКИ ---

    printf("Отсортированный массив: ");
    for (int i = 0; i < k; i++) {
        printf("%d ", arr[i]);
    }
    printf("\k");

    return 0;
}