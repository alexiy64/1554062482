// Отключает ошибку безопасности scanf в Visual Studio (C++)
#define _CRT_SECURE_NO_WARNINGS 

#include <stdio.h>
#include <stdlib.h>

int main(void) {
    int k;
    printf("Сколько чисел будет в массиве? ");
    scanf("%d", &k);

    if (k < 0) {
        printf("Число неверное!");
    }

    // выделение памяти
    int* arr = (int*)malloc(k * sizeof(int));

    if (arr == NULL) {
        printf("Ошибка: не хватило памяти!\n");
        return 1;
    }

    printf("Введите %d чисел:\n", k);
    for (int i = 0; i < k; i++) {
        scanf("%d", &arr[i]);
    }

    printf("Исходный массив: ");
    for (int i = 0; i < k; i++) {
        printf("%d ", arr[i]);
    }

    printf("\n");

    // Сортировка
    for (int i = 0; i < k - 1; i++) {
        for (int j = 0; j < k - i - 1; j++) {
            if (arr[j] > arr[j + 1]) {
                int temp = arr[j];
                arr[j] = arr[j + 1];
                arr[j + 1] = temp;
            }
        }
    }

    printf("Отсортированный массив: ");
    for (int i = 0; i < k; i++) {
        printf("%d ", arr[i]);
    }

    printf("\n");

    // Освобождение памяти
    free(arr);
    return 0;
}
